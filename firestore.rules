/**
 * @fileoverview Firestore Security Rules for the CyberWall Scanner application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model. Each user has full control
 * over their own data, and no user can access another user's data.  All data
 * is nested under /users/{userId}.
 *
 * Data Structure:
 * The Firestore database is structured as follows:
 * - /users/{userId}: Stores user profiles.
 * - /users/{userId}/scans/{scanId}: Stores scans performed by a user.
 * - /users/{userId}/scans/{scanId}/reports/{reportId}: Stores reports generated for a scan.
 * - /users/{userId}/scans/{scanId}/reports/{reportId}/findings/{findingId}: Stores findings included in a report.
 *
 * Key Security Decisions:
 * - User data is strictly segregated based on the Firebase Authentication UID.
 * - No listing of the /users collection is allowed to protect user privacy.
 * - Only authenticated users can create data.
 * - All write operations are restricted to the owner of the respective document.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Prevents listing all users, restricts access to individual user documents.
     * @path /users/{userId}
     * @allow (get) Authenticated user can read their own profile.
     * @deny (get) Authenticated user cannot read other user's profile.
     * @deny (list) No one can list all users.
     * @allow (create) Authenticated user can create their own profile (self-creation).
     * @deny (create) Authenticated user cannot create a profile with a different user ID.
     * @allow (update) Authenticated user can update their own profile.
     * @deny (update) Authenticated user cannot update another user's profile.
     * @allow (delete) Authenticated user can delete their own profile.
     * @deny (delete) Authenticated user cannot delete another user's profile.
     * @principle Enforces document ownership and prevents unauthorized access.
     */
    match /users/{userId} {
      // Only signed-in users can attempt to access user documents
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false; // Prevent listing all users.
      allow create: if isSignedIn() && isSelfCreate(userId);
      allow update: if isSignedIn() && isExistingOwner(userId) && isUserIdNotChanged(userId);
      allow delete: if isSignedIn() && isExistingOwner(userId);
    }

    /**
     * @description Manages scans for a specific user.
     * @path /users/{userId}/scans/{scanId}
     * @allow (get) Authenticated user can read their own scan.
     * @deny (get) Authenticated user cannot read other user's scan.
     * @allow (list) Authenticated user can list their own scans.
     * @deny (list) Authenticated user cannot list other user's scans.
     * @allow (create) Authenticated user can create a scan under their own user ID.
     * @deny (create) Authenticated user cannot create a scan under another user ID.
     * @allow (update) Authenticated user can update their own scan.
     * @deny (update) Authenticated user cannot update another user's scan.
     * @allow (delete) Authenticated user can delete their own scan.
     * @deny (delete) Authenticated user cannot delete another user's scan.
     * @principle Enforces document ownership and prevents unauthorized access.
     */
    match /users/{userId}/scans/{scanId} {
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isExistingOwner(userId);
      allow delete: if isSignedIn() && isExistingOwner(userId);
    }

    /**
     * @description Manages reports for a specific scan under a specific user.
     * @path /users/{userId}/scans/{scanId}/reports/{reportId}
     * @allow (get) Authenticated user can read their own report.
     * @deny (get) Authenticated user cannot read other user's report.
     * @allow (list) Authenticated user can list their own reports.
     * @deny (list) Authenticated user cannot list other user's reports.
     * @allow (create) Authenticated user can create a report under their own user ID and scan ID.
     * @deny (create) Authenticated user cannot create a report under another user ID or scan ID.
     * @allow (update) Authenticated user can update their own report.
     * @deny (update) Authenticated user cannot update another user's report.
     * @allow (delete) Authenticated user can delete their own report.
     * @deny (delete) Authenticated user cannot delete another user's report.
     * @principle Enforces document ownership and prevents unauthorized access.
     */
    match /users/{userId}/scans/{scanId}/reports/{reportId} {
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isExistingOwner(userId);
      allow delete: if isSignedIn() && isExistingOwner(userId);
    }

    /**
     * @description Manages findings for a specific report under a specific scan under a specific user.
     * @path /users/{userId}/scans/{scanId}/reports/{reportId}/findings/{findingId}
     * @allow (get) Authenticated user can read their own finding.
     * @deny (get) Authenticated user cannot read other user's finding.
     * @allow (list) Authenticated user can list their own findings.
     * @deny (list) Authenticated user cannot list other user's findings.
     * @allow (create) Authenticated user can create a finding under their own user ID, scan ID, and report ID.
     * @deny (create) Authenticated user cannot create a finding under another user ID, scan ID, or report ID.
     * @allow (update) Authenticated user can update their own finding.
     * @deny (update) Authenticated user cannot update another user's finding.
     * @allow (delete) Authenticated user can delete their own finding.
     * @deny (delete) Authenticated user cannot delete another user's finding.
     * @principle Enforces document ownership and prevents unauthorized access.
     */
    match /users/{userId}/scans/{scanId}/reports/{reportId}/findings/{findingId} {
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isExistingOwner(userId);
      allow delete: if isSignedIn() && isExistingOwner(userId);
    }
  }

  // Helper functions

  // Check if the user is signed in.
  function isSignedIn() {
    return request.auth != null;
  }

  //Check that the user's ID from auth matches the userId passed into the function, indicating ownership.
  function isOwner(userId) {
    return request.auth.uid == userId;
  }

    // Check if the user is creating their own user document.
  function isSelfCreate(userId) {
    return request.auth.uid == userId && request.resource.data.id == userId;
  }

  // Check if the user is the owner and the resource exists (for update/delete).
  function isExistingOwner(userId) {
    return isOwner(userId) && resource != null;
  }

    // Prevents the user ID from being changed on update.
  function isUserIdNotChanged(userId) {
    return resource.data.id == userId;
  }
}