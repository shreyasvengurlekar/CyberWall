/**
 * @fileoverview Firestore Security Rules for CyberWall Scanner application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model. Each user can only access their own data (profiles, scans, reports, findings).
 *
 * Data Structure:
 * All data is nested under /users/{userId}, ensuring path-based authorization. Specifically:
 * - /users/{userId}: User profiles
 * - /users/{userId}/scans/{scanId}: Scans performed by the user
 * - /users/{userId}/scans/{scanId}/reports/{reportId}: Reports for each scan
 * - /users/{userId}/scans/{scanId}/reports/{reportId}/findings/{findingId}: Findings for each report
 *
 * Key Security Decisions:
 * - Users can only create their own user document (self-registration).
 * - Users cannot list all user documents (privacy).
 * - All subcollections under /users/{userId} are accessible only to the user.
 *
 * Denormalization for Authorization:
 * The data structure denormalizes ownership into the path itself (/users/{userId}/...).
 * This avoids the need for costly `get()` calls in the security rules to verify ownership.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Enforces user-ownership for user profiles. Users can only read/write their own profile.
     * @path /users/{userId}
     * @allow (create) - User with UID 'user123' can create document /users/user123
     * @allow (get, update, delete) - User with UID 'user123' can get, update, and delete document /users/user123
     * @deny (create) - User with UID 'user456' cannot create document /users/user123
     * @deny (get, update, delete) - User with UID 'user456' cannot get, update, or delete document /users/user123
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      //function
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }
      allow get: if isOwner(userId);
      allow list: if false; // User listing is not allowed

      // Allow the user to create their own document, enforcing id match for integrity
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.id == userId;

      // Only allow updates and deletes if the user is the owner and the document exists. Enforce immutability of userId.
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Enforces user-ownership for scans. Users can only read/write their own scans.
     * @path /users/{userId}/scans/{scanId}
     * @allow (create) - User with UID 'user123' can create document /users/user123/scans/scan456
     * @allow (get, update, delete) - User with UID 'user123' can get, update, and delete document /users/user123/scans/scan456
     * @allow (list) - User with UID 'user123' can list documents in /users/user123/scans
     * @deny (create) - User with UID 'user456' cannot create document /users/user123/scans/scan456
     * @deny (get, update, delete) - User with UID 'user456' cannot get, update, or delete document /users/user123/scans/scan456
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/scans/{scanId} {
       //function
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);

      // Only the owner can create new scans. Enforce userId consistency.
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.userId == userId;

      // Only the owner can update or delete scans.  Enforce immutability of userId.
      allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Enforces user-ownership for reports. Users can only read/write their own reports.
     * @path /users/{userId}/scans/{scanId}/reports/{reportId}
     * @allow (create) - User with UID 'user123' can create document /users/user123/scans/scan456/reports/report789
     * @allow (get, update, delete) - User with UID 'user123' can get, update, and delete document /users/user123/scans/scan456/reports/report789
     * @allow (list) - User with UID 'user123' can list documents in /users/user123/scans/scan456/reports
     * @deny (create) - User with UID 'user456' cannot create document /users/user123/scans/scan456/reports/report789
     * @deny (get, update, delete) - User with UID 'user456' cannot get, update, or delete document /users/user123/scans/scan456/reports/report789
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/scans/{scanId}/reports/{reportId} {
      //function
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);

      // Only the owner can create new reports.  Enforce userId consistency.
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.scanId == scanId;

      // Only the owner can update or delete reports.  Enforce immutability of scanId.
      allow update: if isExistingOwner(userId) && request.resource.data.scanId == resource.data.scanId;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Enforces user-ownership for findings. Users can only read/write their own findings.
     * @path /users/{userId}/scans/{scanId}/reports/{reportId}/findings/{findingId}
     * @allow (create) - User with UID 'user123' can create document /users/user123/scans/scan456/reports/report789/findings/finding012
     * @allow (get, update, delete) - User with UID 'user123' can get, update, and delete document /users/user123/scans/scan456/reports/report789/findings/finding012
     * @allow (list) - User with UID 'user123' can list documents in /users/user123/scans/scan456/reports/report789/findings
     * @deny (create) - User with UID 'user456' cannot create document /users/user123/scans/scan456/reports/report789/findings/finding012
     * @deny (get, update, delete) - User with UID 'user456' cannot get, update, or delete document /users/user123/scans/scan456/reports/report789/findings/finding012
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/scans/{scanId}/reports/{reportId}/findings/{findingId} {
      //function
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);

      // Only the owner can create new findings.  Enforce reportId consistency.
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.reportId == reportId;

      // Only the owner can update or delete findings. Enforce immutability of reportId.
      allow update: if isExistingOwner(userId) && request.resource.data.reportId == resource.data.reportId;
      allow delete: if isExistingOwner(userId);
    }
  }
}