/**
 * @fileoverview Firestore Security Rules for CyberWall Scanner application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model. Each user can only access their own data.
 *
 * Data Structure:
 * All data is nested under /users/{userId}, ensuring path-based authorization.
 * - /users/{userId}: User profile information.
 * - /users/{userId}/scans/{scanId}: Scan data for a specific user.
 * - /users/{userId}/scans/{scanId}/reports/{reportId}: Reports associated with a scan.
 * - /users/{userId}/scans/{scanId}/reports/{reportId}/findings/{findingId}: Findings within a report.
 *
 * Key Security Decisions:
 * - Users can only create, read, update, and delete data under their own user ID.
 * - The rules are structured to prevent unauthorized access to user data.
 * - List operations are restricted to the owner of the data.
 *
 * Denormalization for Authorization:
 * The data structure is organized to avoid the need for `get()` calls in the rules.
 * Ownership is determined by the path, and the `userId` parameter corresponds to the authenticated user's UID.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profiles.
     * @path /users/{userId}
     * @allow (create) User with matching UID can create their profile.
     * @allow (get, list, update, delete) User with matching UID can read, update, and delete their profile.
     * @deny (create) User cannot create a profile with a mismatched UID.
     * @deny (get, list, update, delete) User cannot read, update, or delete another user's profile.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if false; // Listing all users is not permitted.

      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to scans performed by a user.
     * @path /users/{userId}/scans/{scanId}
     * @allow (create) User with matching UID can create a scan under their profile.
     * @allow (get, list, update, delete) User with matching UID can read, update, and delete their scans.
     * @deny (create) User cannot create a scan with a mismatched UID.
     * @deny (get, list, update, delete) User cannot read, update, or delete another user's scan.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/scans/{scanId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);

      allow create: if isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to reports generated for a scan.
     * @path /users/{userId}/scans/{scanId}/reports/{reportId}
     * @allow (create) User with matching UID can create a report under their scan.
     * @allow (get, list, update, delete) User with matching UID can read, update, and delete their reports.
     * @deny (create) User cannot create a report with a mismatched UID.
     * @deny (get, list, update, delete) User cannot read, update, or delete another user's report.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/scans/{scanId}/reports/{reportId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);

      allow create: if isOwner(userId) && request.resource.data.scanId == scanId;
      allow update: if isExistingOwner(userId) && request.resource.data.scanId == resource.data.scanId;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to findings included in a report.
     * @path /users/{userId}/scans/{scanId}/reports/{reportId}/findings/{findingId}
     * @allow (create) User with matching UID can create a finding under their report.
     * @allow (get, list, update, delete) User with matching UID can read, update, and delete their findings.
     * @deny (create) User cannot create a finding with a mismatched UID.
     * @deny (get, list, update, delete) User cannot read, update, or delete another user's finding.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/scans/{scanId}/reports/{reportId}/findings/{findingId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);

      allow create: if isOwner(userId) && request.resource.data.reportId == reportId;
      allow update: if isExistingOwner(userId) && request.resource.data.reportId == resource.data.reportId;
      allow delete: if isExistingOwner(userId);
    }
  }
}