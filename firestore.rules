rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Enforces user-based access control for user profile documents. Only the authenticated user can read or write their own profile.
     * @path /users/{userId}
     * @allow (create) User with ID 'user123' creates their profile.
     *   - Auth: {uid: 'user123'}
     *   - Request: {data: {id: 'user123', email: 'test@example.com', createdAt: '2024-01-01T00:00:00Z'}}
     * @allow (get) User with ID 'user123' retrieves their profile.
     *   - Auth: {uid: 'user123'}
     * @allow (update) User with ID 'user123' updates their profile.
     *   - Auth: {uid: 'user123'}
     *   - Request: {data: {id: 'user123', email: 'new_email@example.com', createdAt: '2024-01-01T00:00:00Z'}}
     * @allow (delete) User with ID 'user123' deletes their profile.
     *   - Auth: {uid: 'user123'}
     * @deny (create) User with ID 'user123' attempts to create a profile with a mismatched ID.
     *   - Auth: {uid: 'user123'}
     *   - Request: {data: {id: 'user456', email: 'test@example.com', createdAt: '2024-01-01T00:00:00Z'}}
     * @deny (get) User with ID 'user456' attempts to retrieve user 'user123's profile.
     *   - Auth: {uid: 'user456'}
     * @deny (update) User with ID 'user456' attempts to update user 'user123's profile.
     *   - Auth: {uid: 'user456'}
     *   - Request: {data: {id: 'user123', email: 'new_email@example.com', createdAt: '2024-01-01T00:00:00Z'}}
     * @deny (delete) User with ID 'user456' attempts to delete user 'user123's profile.
     *   - Auth: {uid: 'user456'}
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      // Helper function to check if the user is signed in
      function isSignedIn() {
        return request.auth != null;
      }

      // Helper function to check if the authenticated user is the owner of the resource
      function isOwner(userId) {
        return isSignedIn() && request.auth.uid == userId;
      }

      // Helper function to check if the authenticated user is the owner of the existing resource
      function isExistingOwner(userId) {
        return isSignedIn() && request.auth.uid == userId;
      }

      allow get: if isOwner(userId);
      allow list: if false; // Listing users is not allowed.
      allow create: if request.auth.uid == userId;
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Enforces user-based access control for scan documents. Only the authenticated user (owner) can create, read, update, or delete their own scans.
     * @path /users/{userId}/scans/{scanId}
     * @allow (create) User with ID 'user123' creates a new scan.
     *   - Auth: {uid: 'user123'}
     *   - Request: {data: {id: 'scan456', userId: 'user123', url: 'http://example.com', scanType: 'quick', startTime: '2024-01-01T00:00:00Z', status: 'pending'}}
     * @allow (get) User with ID 'user123' retrieves their scan with ID 'scan456'.
     *   - Auth: {uid: 'user123'}
     * @allow (list) User with ID 'user123' lists their own scans.
     *   - Auth: {uid: 'user123'}
     * @allow (update) User with ID 'user123' updates their scan with ID 'scan456'.
     *   - Auth: {uid: 'user123'}
     *   - Request: {data: {id: 'scan456', userId: 'user123', url: 'http://example.com', scanType: 'quick', startTime: '2024-01-01T00:00:00Z', status: 'completed'}}
     * @allow (delete) User with ID 'user123' deletes their scan with ID 'scan456'.
     *   - Auth: {uid: 'user123'}
     * @deny (create) User with ID 'user456' attempts to create a scan for user 'user123'.
     *   - Auth: {uid: 'user456'}
     *   - Request: {data: {id: 'scan456', userId: 'user123', url: 'http://example.com', scanType: 'quick', startTime: '2024-01-01T00:00:00Z', status: 'pending'}}
     * @deny (get) User with ID 'user456' attempts to retrieve a scan owned by user 'user123'.
     *   - Auth: {uid: 'user456'}
     * @deny (list) User with ID 'user456' attempts to list scans owned by user 'user123'.
     *   - Auth: {uid: 'user456'}
     * @deny (update) User with ID 'user456' attempts to update a scan owned by user 'user123'.
     *   - Auth: {uid: 'user456'}
     *   - Request: {data: {id: 'scan456', userId: 'user123', url: 'http://example.com', scanType: 'quick', startTime: '2024-01-01T00:00:00Z', status: 'completed'}}
     * @deny (delete) User with ID 'user456' attempts to delete a scan owned by user 'user123'.
     *   - Auth: {uid: 'user456'}
     * @principle Enforces document ownership for all operations within the user's scans subcollection.
     */
    match /users/{userId}/scans/{scanId} {
      allow get: if request.auth.uid == userId;
      allow list: if request.auth.uid == userId;
      allow create: if request.auth.uid == userId;
      allow update: if request.auth.uid == userId;
      allow delete: if request.auth.uid == userId;
    }

    /**
     * @description Enforces user-based access control for report documents. Only the authenticated user (owner) can create, read, update, or delete their own reports.
     * @path /users/{userId}/scans/{scanId}/reports/{reportId}
     * @allow (create) User with ID 'user123' creates a new report for their scan.
     *   - Auth: {uid: 'user123'}
     *   - Request: {data: {id: 'report789', scanId: 'scan456', generatedTime: '2024-01-02T00:00:00Z', summary: 'No vulnerabilities found'}}
     * @allow (get) User with ID 'user123' retrieves their report with ID 'report789'.
     *   - Auth: {uid: 'user123'}
     * @allow (list) User with ID 'user123' lists their own reports for a specific scan.
     *   - Auth: {uid: 'user123'}
     * @allow (update) User with ID 'user123' updates their report with ID 'report789'.
     *   - Auth: {uid: 'user123'}
     *   - Request: {data: {id: 'report789', scanId: 'scan456', generatedTime: '2024-01-02T00:00:00Z', summary: 'Minor vulnerabilities found'}}
     * @allow (delete) User with ID 'user123' deletes their report with ID 'report789'.
     *   - Auth: {uid: 'user123'}
     * @deny (create) User with ID 'user456' attempts to create a report for user 'user123's scan.
     *   - Auth: {uid: 'user456'}
     *   - Request: {data: {id: 'report789', scanId: 'scan456', generatedTime: '2024-01-02T00:00:00Z', summary: 'No vulnerabilities found'}}
     * @deny (get) User with ID 'user456' attempts to retrieve a report owned by user 'user123'.
     *   - Auth: {uid: 'user456'}
     * @deny (list) User with ID 'user456' attempts to list reports owned by user 'user123'.
     *   - Auth: {uid: 'user456'}
     * @deny (update) User with ID 'user456' attempts to update a report owned by user 'user123'.
     *   - Auth: {uid: 'user456'}
     *   - Request: {data: {id: 'report789', scanId: 'scan456', generatedTime: '2024-01-02T00:00:00Z', summary: 'Minor vulnerabilities found'}}
     * @deny (delete) User with ID 'user456' attempts to delete a report owned by user 'user123'.
     *   - Auth: {uid: 'user456'}
     * @principle Enforces document ownership for all operations within the user's reports subcollection.
     */
    match /users/{userId}/scans/{scanId}/reports/{reportId} {
      allow get: if request.auth.uid == userId;
      allow list: if request.auth.uid == userId;
      allow create: if request.auth.uid == userId;
      allow update: if request.auth.uid == userId;
      allow delete: if request.auth.uid == userId;
    }

    /**
     * @description Enforces user-based access control for finding documents. Only the authenticated user (owner) can create, read, update, or delete their own findings.
     * @path /users/{userId}/scans/{scanId}/reports/{reportId}/findings/{findingId}
     * @allow (create) User with ID 'user123' creates a new finding for their report.
     *   - Auth: {uid: 'user123'}
     *   - Request: {data: {id: 'finding101', reportId: 'report789', severity: 'high', type: 'XSS', description: 'Cross-site scripting vulnerability', suggestedFix: 'Sanitize user inputs'}}
     * @allow (get) User with ID 'user123' retrieves their finding with ID 'finding101'.
     *   - Auth: {uid: 'user123'}
     * @allow (list) User with ID 'user123' lists their own findings for a specific report.
     *   - Auth: {uid: 'user123'}
     * @allow (update) User with ID 'user123' updates their finding with ID 'finding101'.
     *   - Auth: {uid: 'user123'}
     *   - Request: {data: {id: 'finding101', reportId: 'report789', severity: 'critical', type: 'SQL injection', description: 'SQL injection vulnerability', suggestedFix: 'Use parameterized queries'}}
     * @allow (delete) User with ID 'user123' deletes their finding with ID 'finding101'.
     *   - Auth: {uid: 'user123'}
     * @deny (create) User with ID 'user456' attempts to create a finding for user 'user123's report.
     *   - Auth: {uid: 'user456'}
     *   - Request: {data: {id: 'finding101', reportId: 'report789', severity: 'high', type: 'XSS', description: 'Cross-site scripting vulnerability', suggestedFix: 'Sanitize user inputs'}}
     * @deny (get) User with ID 'user456' attempts to retrieve a finding owned by user 'user123'.
     *   - Auth: {uid: 'user456'}
     * @deny (list) User with ID 'user456' attempts to list findings owned by user 'user123'.
     *   - Auth: {uid: 'user456'}
     * @deny (update) User with ID 'user456' attempts to update a finding owned by user 'user123'.
     *   - Auth: {uid: 'user456'}
     *   - Request: {data: {id: 'finding101', reportId: 'report789', severity: 'critical', type: 'SQL injection', description: 'SQL injection vulnerability', suggestedFix: 'Use parameterized queries'}}
     * @deny (delete) User with ID 'user456' attempts to delete a finding owned by user 'user123'.
     *   - Auth: {uid: 'user456'}
     * @principle Enforces document ownership for all operations within the user's findings subcollection.
     */
    match /users/{userId}/scans/{scanId}/reports/{reportId}/findings/{findingId} {
      allow get: if request.auth.uid == userId;
      allow list: if request.auth.uid == userId;
      allow create: if request.auth.uid == userId;
      allow update: if request.auth.uid == userId;
      allow delete: if request.auth.uid == userId;
    }
  }
}