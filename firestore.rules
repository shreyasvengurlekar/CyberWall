/**
 * @fileoverview Firestore Security Rules for CyberWall Scanner application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model. Each user can only access their own data (Users, Scans, Reports, Findings).
 *
 * Data Structure:
 * The Firestore database is structured as follows:
 * - /users/{userId}: Stores user profiles, where {userId} matches the Firebase auth UID.
 * - /users/{userId}/scans/{scanId}: Stores scan data for a specific user.
 * - /users/{userId}/scans/{scanId}/reports/{reportId}: Stores reports associated with a scan.
 * - /users/{userId}/scans/{scanId}/reports/{reportId}/findings/{findingId}: Stores individual findings for a report.
 *
 * Key Security Decisions:
 * - Users can only create, read, update, and delete their own data.
 * - Listing all users is disallowed for privacy.
 * - Data consistency between the path and the document's internal fields is enforced.
 *
 * Denormalization for Authorization:
 * The data structure denormalizes the `userId` into the path to avoid costly `get()` calls. For example, all scans are stored under `/users/{userId}/scans/{scanId}`, making it easy to verify ownership using `isOwner(userId)`.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Enforces user-level access control.  Users can only read and write their own profile data.
     * @path /users/{userId}
     * @allow (create) User with UID 'user123' can create their profile if request.auth.uid == 'user123'.
     * @allow (get) User with UID 'user123' can read their profile.
     * @allow (update) User with UID 'user123' can update their profile.
     * @allow (delete) User with UID 'user123' can delete their profile.
     * @deny (create) User with UID 'user456' cannot create a profile for 'user123'.
     * @deny (get) User with UID 'user456' cannot read the profile of 'user123'.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Enforces user-level access control for scans. Users can only read and write scans they own.
     * @path /users/{userId}/scans/{scanId}
     * @allow (create) User 'user123' can create a scan under their profile if request.auth.uid == 'user123'.
     * @allow (get) User 'user123' can read a scan under their profile.
     * @allow (update) User 'user123' can update a scan under their profile.
     * @allow (delete) User 'user123' can delete a scan under their profile.
     * @deny (create) User 'user456' cannot create a scan under the profile of 'user123'.
     * @deny (get) User 'user456' cannot read a scan from the profile of 'user123'.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/scans/{scanId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
       function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
      allow delete: if isExistingOwner(userId);
    }

     /**
      * @description Enforces user-level access control for reports. Users can only read and write reports for scans they own.
      * @path /users/{userId}/scans/{scanId}/reports/{reportId}
      * @allow (create) User 'user123' can create a report for their scan if request.auth.uid == 'user123'.
      * @allow (get) User 'user123' can read a report for their scan.
      * @allow (update) User 'user123' can update a report for their scan.
      * @allow (delete) User 'user123' can delete a report for their scan.
      * @deny (create) User 'user456' cannot create a report under the scan of 'user123'.
      * @deny (get) User 'user456' cannot read a report from the scan of 'user123'.
      * @principle Enforces document ownership for all operations.
      */
    match /users/{userId}/scans/{scanId}/reports/{reportId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
       function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Enforces user-level access control for findings. Users can only read and write findings for reports they own.
     * @path /users/{userId}/scans/{scanId}/reports/{reportId}/findings/{findingId}
     * @allow (create) User 'user123' can create a finding for their report if request.auth.uid == 'user123'.
     * @allow (get) User 'user123' can read a finding for their report.
     * @allow (update) User 'user123' can update a finding for their report.
     * @allow (delete) User 'user123' can delete a finding for their report.
     * @deny (create) User 'user456' cannot create a finding under the report of 'user123'.
     * @deny (get) User 'user456' cannot read a finding from the report of 'user123'.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/scans/{scanId}/reports/{reportId}/findings/{findingId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
       function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }
  }
}